<?xml version="1.0" encoding="utf-8"?>
<!-- The API 21+ variant, which is what every real device actually uses; the
     drawable/ copy is the pre-21 fallback and is kept identical. Both mirror
     ios/Runner/Base.lproj/LaunchScreen.storyboard so cold start looks the same
     on Android and iOS. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
