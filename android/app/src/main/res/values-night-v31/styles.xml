<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces the launch drawable with the system splash screen:
     the launcher icon centred on windowSplashScreenBackground. Both are set
     explicitly, because left to defaults some OEM builds (Samsung One UI)
     show a bare background with no icon. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
