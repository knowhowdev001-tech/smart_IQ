<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start screen. Kept in step with
     ios/Runner/Base.lproj/LaunchScreen.storyboard: the same brand mark centred
     on the same mint (#12E29B), so launching looks identical on both
     platforms. The logo sits in its own navy tile, so the night variant
     needs nothing different. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
